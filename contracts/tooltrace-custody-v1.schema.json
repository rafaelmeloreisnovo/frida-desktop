{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/frida-desktop/blob/audit/tooltrace-evidence-custody-20261105/contracts/tooltrace-custody-v1.schema.json",
  "title": "RAFAELIA Tooltrace custody line",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_sha256",
    "evidence",
    "claim_allowed",
    "record_sha256"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.tooltrace-custody/v1"
    },
    "parent_sha256": {
      "anyOf": [
        {
          "const": "GENESIS"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCREENSHOT_BYTES",
            "EXPORTED_EVENT_METADATA"
          ]
        }
      },
      "additionalProperties": true
    },
    "claim_allowed": {
      "const": false
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
